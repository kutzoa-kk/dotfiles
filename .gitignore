# SSH config (contains IPs and hostnames)
dotdir/.ssh/config

# Codex config (machine-local: paths, [projects] trust history, hooks.state, auto-generated timestamps)
dotdir/.codex/config.toml
/*
/.**

!/.zshrc
!/.zprofile
!/.vimrc
!/.gitignore_global
!/.gitconfig
!/.config/
!/.config/**

# Machine-local state mistakenly committed under .config (re-exclude from the allowlist above)
/.config/Autodesk/
/.config/iterm2/
/.config/raycast/
/.config/wireshark/
!/Brewfile

## etc
!/.bin/
!/.bin/**

!/README.md
!/LICENCE
!.gitignore
!.gitkeep
!/install.sh
!/install_brew.sh
!/.github/
!/.github/**

## Docs (design specs / plans / reports = 監査証跡)
# /* が docs/ を無視するため新規ファイルが落ちる。ルートと同じ手法を docs 階層に適用:
# docs/ を許可 → 直下を再度無視 → 監査証跡サブツリーのみ許可（docs/archive はキャッシュを含むので除外のまま）。
!/docs/
/docs/*
!/docs/superpowers/
!/docs/superpowers/**
!/docs/reports/
!/docs/reports/**

## dotdir/.claude/scripts (hooks・statusline スクリプト = 稼働設定の実体)
# /* が dotdir/ 配下の新規ファイルを無視するため docs と同じ手法で allowlist。
!/dotdir/
/dotdir/*
!/dotdir/.claude/
/dotdir/.claude/*
!/dotdir/.claude/scripts/
!/dotdir/.claude/scripts/**

## dotdir/.claude/skills — 追跡するスキルを個別に allowlist（同上の手法）
!/dotdir/.claude/skills/
/dotdir/.claude/skills/*
!/dotdir/.claude/skills/stop-ai-slop/
!/dotdir/.claude/skills/stop-ai-slop/**
!/dotdir/.claude/skills/humanize-ja/
!/dotdir/.claude/skills/humanize-ja/**
!/dotdir/.claude/skills/graphify/
!/dotdir/.claude/skills/graphify/**
!/dotdir/.claude/skills/japanese-output-review/
!/dotdir/.claude/skills/japanese-output-review/**
!/dotdir/.claude/skills/ml-experiment-traceability/
!/dotdir/.claude/skills/ml-experiment-traceability/**
!/dotdir/.claude/skills/slack-dm-summary/
!/dotdir/.claude/skills/slack-dm-summary/**
!/dotdir/.claude/skills/mvh-setup/
!/dotdir/.claude/skills/mvh-setup/**

# macOS メタデータ（allowlist したサブツリー内でも常に無視）
.DS_Store

